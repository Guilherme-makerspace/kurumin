<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista</title>
</head>
<body>
    <h1>Lista de Categoria</h1>

    <table>
        <thead>
            <tr>
                <th>Nome</th>
                <th>Descrição</th>
                <th>Ação</th>
            </tr>
        </thead>
        <tbody>

            <% for (let dado of dados){ %>

            <tr>
                <td> <%= dado.nome %></td>
                <td> <%= dado.descricao %></td>
                <td>
                    <Button><a href="/categoria/editar/<%= dado.id_categoria %>">Editar</a> </Button>
                    <Button><a href="/categoria/apagar/<%= dado.id_categoria %>">Apagar</a> </Button>
                </td>
            </tr>

            <% } %>
            
        </tbody>
    </table>
</body>
</html>